<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_mint"
    android:paddingHorizontal="24dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.26" />

    <ImageView
        android:id="@+id/ivMainLogo"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginTop="48dp"
        android:src="@drawable/main_logo"
        android:contentDescription="NutriSense Plant Logo"
        android:scaleType="fitCenter"
        android:background="@drawable/rounded_logo_bg"
        android:padding="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to"
        android:fontFamily="@font/poppins_bold"
        android:textColor="@color/text_dark_green"
        android:textSize="28sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topGuideline" />

    <TextView
        android:id="@+id/tvBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-6dp"
        android:text="NutriSense"
        android:fontFamily="@font/poppins_bold"
        android:textColor="@color/text_dark_green"
        android:textSize="28sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Smart farming made simple with\nprecision nutrient management"
        android:textAlignment="center"
        android:textColor="@color/text_gray"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBrand" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/card_clickable_bg"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <ImageView
            android:id="@+id/ivCard1Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_plant"
            android:contentDescription="Real-Time Monitoring Icon"
            app:tint="#4CAF50"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvCard1Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Real-Time Monitoring"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/ivCard1Icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivCard1Icon"
            app:layout_constraintBottom_toTopOf="@+id/tvCard1Desc"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvCard1Desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Track N, P, K levels and soil moisture instantly"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/ivCard1Icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCard1Title"
            app:layout_constraintBottom_toBottomOf="@+id/ivCard1Icon" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/card_clickable_bg"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card1">

        <ImageView
            android:id="@+id/ivCard2Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_graph"
            android:contentDescription="Smart Recommendations Icon"
            app:tint="#FF9800"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvCard2Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Smart Recommendations"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/ivCard2Icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivCard2Icon"
            app:layout_constraintBottom_toTopOf="@+id/tvCard2Desc"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvCard2Desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Get AI-powered crop suggestions based on soil data"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/ivCard2Icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCard2Title"
            app:layout_constraintBottom_toBottomOf="@+id/ivCard2Icon" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/card_clickable_bg"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card2">

        <ImageView
            android:id="@+id/ivCard3Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Automated Control Icon"
            android:src="@drawable/ic_water"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0"
            app:tint="#2196F3" />

        <TextView
            android:id="@+id/tvCard3Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Automated Control"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/ivCard3Icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivCard3Icon"
            app:layout_constraintBottom_toTopOf="@+id/tvCard3Desc"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvCard3Desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Manage irrigation systems automatically"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/ivCard3Icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCard3Title"
            app:layout_constraintBottom_toBottomOf="@+id/ivCard3Icon" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/card_clickable_bg"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card3">

        <ImageView
            android:id="@+id/ivCard4Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_sms"
            android:contentDescription="SMS Alerts Icon"
            app:tint="#9C27B0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvCard4Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="SMS Alerts"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/ivCard4Icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivCard4Icon"
            app:layout_constraintBottom_toTopOf="@+id/tvCard4Desc"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvCard4Desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Receive important updates even when offline"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/ivCard4Icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCard4Title"
            app:layout_constraintBottom_toBottomOf="@+id/ivCard4Icon" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGetStarted"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/rounded_button_bg"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textColor="@color/bg_white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:elevation="6dp"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toTopOf="@id/tvFooter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Start your journey to smarter farming today"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>