<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_clickable_bg"
    android:padding="0dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Question Row -->
    <LinearLayout
        android:id="@+id/ll_faq_question_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="Expand FAQ question">

        <TextView
            android:id="@+id/tv_faq_question"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/nutrisense_dark_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.2" />

        <ImageView
            android:id="@+id/iv_faq_arrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_arrow_forward"
            android:rotation="90"
            android:contentDescription="Expand answer"
            app:tint="@color/nutrisense_green" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/divider_faq"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB"
        android:visibility="gone" />

    <!-- Answer -->
    <TextView
        android:id="@+id/tv_faq_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:textColor="@color/nutrisense_gray_text"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.4"
        android:visibility="gone" />

</LinearLayout>
